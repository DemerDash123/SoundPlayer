<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="12dp">

    <FrameLayout
        android:layout_width="210dp"
        android:layout_height="210dp">

        <ImageView
            android:id="@+id/detail_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_card_high"
            android:elevation="10dp"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/detail_icon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center"
            android:elevation="11dp"
            android:importantForAccessibility="no"
            android:tint="@color/white"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/detail_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:textColor="?attr/spText"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/detail_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:textColor="?attr/spTextDim"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/detail_play"
            style="@style/SP.PillButton"
            android:background="@drawable/bg_pill_accent"
            android:drawableStart="@drawable/ic_play"
            android:drawableTint="?attr/spOnAccent"
            android:text="@string/play"
            android:textColor="?attr/spOnAccent" />

        <TextView
            android:id="@+id/detail_shuffle"
            style="@style/SP.PillButton"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_pill_outline"
            android:drawableStart="@drawable/ic_shuffle"
            android:drawableTint="?attr/spAccent"
            android:text="@string/shuffle"
            android:textColor="?attr/spAccent" />
    </LinearLayout>
</LinearLayout>
