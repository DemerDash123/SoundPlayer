<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/spBg">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="6dp"
            android:paddingEnd="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/main_title"
                    style="@style/SP.Header"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name" />

                <TextView
                    android:id="@+id/main_subtitle"
                    style="@style/SP.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tagline"
                    android:textColor="?attr/spAccent" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_search"
                style="@style/SP.IconButton"
                android:contentDescription="@string/search"
                android:src="@drawable/ic_search" />

            <ImageButton
                android:id="@+id/btn_sort"
                style="@style/SP.IconButton"
                android:contentDescription="@string/sort"
                android:src="@drawable/ic_sort" />

            <ImageButton
                android:id="@+id/btn_menu"
                style="@style/SP.IconButton"
                android:contentDescription="@string/more"
                android:src="@drawable/ic_more" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/tabs_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />
        </HorizontalScrollView>

        <FrameLayout
            android:id="@+id/pages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:paddingBottom="@dimen/mini_player_space"
                android:scrollbarStyle="outsideOverlay" />

            <GridView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:columnWidth="150dp"
                android:horizontalSpacing="10dp"
                android:numColumns="auto_fit"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="@dimen/mini_player_space"
                android:scrollbarStyle="outsideOverlay"
                android:stretchMode="columnWidth"
                android:verticalSpacing="14dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_circle_soft"
                    android:importantForAccessibility="no"
                    android:padding="18dp"
                    android:src="@drawable/ic_music_note"
                    android:tint="?attr/spAccent" />

                <TextView
                    android:id="@+id/empty_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="@string/empty_library"
                    android:textColor="?attr/spTextDim"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/empty_action"
                    style="@style/SP.PillButton"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_pill_soft"
                    android:text="@string/menu_rescan"
                    android:textColor="?attr/spAccent" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/perm_card"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="32dp">

                    <ImageView
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:background="@drawable/bg_circle_soft"
                        android:importantForAccessibility="no"
                        android:padding="24dp"
                        android:src="@drawable/ic_lock"
                        android:tint="?attr/spAccent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:gravity="center"
                        android:text="@string/perm_title"
                        android:textColor="?attr/spText"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:lineSpacingMultiplier="1.2"
                        android:text="@string/perm_body"
                        android:textColor="?attr/spTextDim"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/perm_button"
                        style="@style/SP.PillButton"
                        android:layout_height="52dp"
                        android:layout_marginTop="28dp"
                        android:background="@drawable/bg_pill_accent"
                        android:paddingStart="36dp"
                        android:paddingEnd="36dp"
                        android:text="@string/perm_button"
                        android:textColor="?attr/spOnAccent" />
                </LinearLayout>
            </ScrollView>

            <ProgressBar
                android:id="@+id/loading"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:indeterminateTint="?attr/spAccent"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <include layout="@layout/mini_player" />
</FrameLayout>
