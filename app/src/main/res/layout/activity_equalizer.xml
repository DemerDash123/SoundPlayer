<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/spBg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/eq_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/eq_back"
            style="@style/SP.IconButton"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/SP.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/eq_title"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/eq_engine"
                style="@style/SP.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <Switch
            android:id="@+id/eq_switch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/eq_enable" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/eq_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/SP.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/eq_presets"
                android:textAllCaps="true" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/eq_presets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />
            </HorizontalScrollView>

            <com.demerdash.soundplayer.ui.EqCurveView
                android:id="@+id/eq_curve"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_card"
                android:contentDescription="@string/eq_title" />

            <LinearLayout
                android:id="@+id/eq_effects"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingTop="6dp"
                android:paddingBottom="10dp" />

            <TextView
                android:id="@+id/eq_reset"
                style="@style/SP.PillButton"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_pill_outline"
                android:text="@string/reset"
                android:textColor="?attr/spAccent" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
