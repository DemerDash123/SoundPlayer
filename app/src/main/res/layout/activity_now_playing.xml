<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/np_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B0C10">

    <ImageView
        android:id="@+id/np_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:id="@+id/np_tint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99101018" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_np_scrim" />

    <LinearLayout
        android:id="@+id/np_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/np_close"
                style="@style/SP.IconButton"
                android:contentDescription="@string/close"
                android:src="@drawable/ic_chevron_down"
                android:tint="@color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="@string/playing_from"
                    android:textColor="@color/white_70"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/np_from"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/np_more"
                style="@style/SP.IconButton"
                android:contentDescription="@string/more"
                android:src="@drawable/ic_more"
                android:tint="@color/white" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/np_art_frame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/np_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:background="@drawable/bg_art_large"
                android:contentDescription="@string/now_playing"
                android:elevation="16dp"
                android:scaleType="centerCrop" />

            <com.demerdash.soundplayer.ui.LyricsView
                android:id="@+id/np_lyrics"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="8dp"
                android:paddingTop="12dp"
                android:paddingEnd="8dp"
                android:paddingBottom="12dp"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/np_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:textAlignment="viewStart"
                    android:textColor="@color/white"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/np_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textAlignment="viewStart"
                    android:textColor="@color/white_70"
                    android:textSize="16sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/np_fav"
                style="@style/SP.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/favorite"
                android:src="@drawable/ic_favorite_border"
                android:tint="@color/white" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/np_seek"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginStart="-14dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="-14dp"
            android:maxHeight="5dp"
            android:minHeight="5dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:progressDrawable="@drawable/seek_progress"
            android:splitTrack="false"
            android:thumb="@drawable/seek_thumb" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/np_pos"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0:00"
                android:textAlignment="viewStart"
                android:textColor="@color/white_70"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/np_dur"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="@color/white_70"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/np_shuffle"
                style="@style/SP.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/shuffle"
                android:src="@drawable/ic_shuffle"
                android:tint="@color/white" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/np_prev"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/previous"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_skip_prev"
                android:tint="@color/white" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.demerdash.soundplayer.ui.PlayPauseView
                android:id="@+id/np_play"
                android:layout_width="78dp"
                android:layout_height="78dp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/np_next"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/next"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_skip_next"
                android:tint="@color/white" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/np_repeat"
                style="@style/SP.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/repeat"
                android:src="@drawable/ic_repeat"
                android:tint="@color/white" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/np_btn_lyrics"
                style="@style/SP.NpAction">

                <ImageView
                    android:id="@+id/np_lyrics_icon"
                    style="@style/SP.NpActionIcon"
                    android:src="@drawable/ic_lyrics" />

                <TextView
                    android:id="@+id/np_lyrics_label"
                    style="@style/SP.NpActionLabel"
                    android:text="@string/lyrics" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/np_btn_speed"
                style="@style/SP.NpAction">

                <ImageView
                    style="@style/SP.NpActionIcon"
                    android:src="@drawable/ic_speed" />

                <TextView
                    android:id="@+id/np_speed_label"
                    style="@style/SP.NpActionLabel"
                    android:text="@string/speed" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/np_btn_sleep"
                style="@style/SP.NpAction">

                <ImageView
                    android:id="@+id/np_sleep_icon"
                    style="@style/SP.NpActionIcon"
                    android:src="@drawable/ic_sleep" />

                <TextView
                    android:id="@+id/np_sleep_label"
                    style="@style/SP.NpActionLabel"
                    android:text="@string/sleep_title" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/np_btn_eq"
                style="@style/SP.NpAction">

                <ImageView
                    style="@style/SP.NpActionIcon"
                    android:src="@drawable/ic_tune" />

                <TextView
                    style="@style/SP.NpActionLabel"
                    android:text="@string/eq_title" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/np_btn_queue"
                style="@style/SP.NpAction">

                <ImageView
                    style="@style/SP.NpActionIcon"
                    android:src="@drawable/ic_queue" />

                <TextView
                    style="@style/SP.NpActionLabel"
                    android:text="@string/queue_title" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
