<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/row_height"
    android:background="?android:attr/selectableItemBackground"
    android:descendantFocusability="blocksDescendants"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="4dp">

    <FrameLayout
        android:layout_width="@dimen/thumb_size"
        android:layout_height="@dimen/thumb_size">

        <ImageView
            android:id="@+id/row_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_art"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/row_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/row_check"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_check"
            android:importantForAccessibility="no"
            android:scaleType="center"
            android:src="@drawable/ic_check"
            android:tint="?attr/spOnAccent"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.demerdash.soundplayer.ui.PlayingBarsView
                android:id="@+id/row_playing"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginEnd="7dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/row_title"
                style="@style/SP.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAlignment="viewStart" />
        </LinearLayout>

        <TextView
            android:id="@+id/row_subtitle"
            style="@style/SP.Subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAlignment="viewStart" />
    </LinearLayout>

    <TextView
        android:id="@+id/row_trailing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="?attr/spTextDim"
        android:textSize="12sp" />

    <ImageButton
        android:id="@+id/row_more"
        style="@style/SP.IconButton"
        android:contentDescription="@string/more"
        android:focusable="false"
        android:src="@drawable/ic_more"
        android:tint="?attr/spTextDim" />
</LinearLayout>
