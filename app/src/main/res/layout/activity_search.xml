<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/spBg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/search_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="12dp">

            <ImageButton
                android:id="@+id/search_back"
                style="@style/SP.IconButton"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_back" />

            <EditText
                android:id="@+id/search_input"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_field"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="10dp"
                android:drawableTint="?attr/spTextDim"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingStart="14dp"
                android:paddingEnd="44dp"
                android:singleLine="true"
                android:textColor="?attr/spText"
                android:textColorHint="?attr/spTextDim"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/search_clear"
                style="@style/SP.IconButton"
                android:layout_marginStart="-44dp"
                android:contentDescription="@string/close"
                android:src="@drawable/ic_close"
                android:tint="?attr/spTextDim"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/search_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:divider="@null"
                android:dividerHeight="0dp"
                android:paddingBottom="@dimen/mini_player_space" />

            <TextView
                android:id="@+id/search_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="64dp"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/search_hint"
                android:textColor="?attr/spTextDim"
                android:textSize="15sp" />
        </FrameLayout>
    </LinearLayout>

    <include layout="@layout/mini_player" />

    <include layout="@layout/selection_bar" />
</FrameLayout>
