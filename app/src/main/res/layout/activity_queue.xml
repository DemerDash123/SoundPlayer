<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/spBg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/queue_top"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/queue_back"
            style="@style/SP.IconButton"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/SP.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/queue_title"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/queue_subtitle"
                style="@style/SP.Subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/queue_more"
            style="@style/SP.IconButton"
            android:contentDescription="@string/more"
            android:src="@drawable/ic_more" />
    </LinearLayout>

    <ListView
        android:id="@+id/queue_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:paddingBottom="16dp" />
</LinearLayout>
