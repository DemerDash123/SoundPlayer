<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_shuffle"
        android:shortcutId="shuffle_all"
        android:shortcutLongLabel="@string/shortcut_shuffle_long"
        android:shortcutShortLabel="@string/shortcut_shuffle">
        <intent
            android:action="com.demerdash.soundplayer.action.SHUFFLE_ALL"
            android:targetClass="com.demerdash.soundplayer.MainActivity"
            android:targetPackage="com.demerdash.soundplayer" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_favorites"
        android:shortcutId="favorites"
        android:shortcutLongLabel="@string/favorites"
        android:shortcutShortLabel="@string/favorites">
        <intent
            android:action="com.demerdash.soundplayer.action.OPEN_FAVORITES"
            android:targetClass="com.demerdash.soundplayer.MainActivity"
            android:targetPackage="com.demerdash.soundplayer" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_search"
        android:shortcutId="search"
        android:shortcutLongLabel="@string/search_hint"
        android:shortcutShortLabel="@string/search">
        <intent
            android:action="com.demerdash.soundplayer.action.SEARCH"
            android:targetClass="com.demerdash.soundplayer.MainActivity"
            android:targetPackage="com.demerdash.soundplayer" />
    </shortcut>
</shortcuts>
